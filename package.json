{
  "name": "event-photo-challenges",
  "version": "0.1.0",
  "private": true,
  "description": "A configurable event photo gallery with creative challenges for Cloudflare Workers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run test && pnpm run lint && pnpm run build",
    "check:deploy": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "photo-archive:build": "node scripts/build-photo-archive.ts",
    "cf-typegen": "wrangler types",
    "i18n": "typesafe-i18n --no-watch"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.3.4",
    "@fontsource-variable/nunito": "^5.2.7",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@mantine/hooks": "^8.3.18",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.95.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.11.1",
    "masonic": "^4.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-rewards": "^2.1.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "torph": "^0.0.9",
    "tw-animate-css": "^1.4.0",
    "typesafe-i18n": "^5.27.1",
    "web-haptics": "^0.0.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/lib-storage": "^3.1081.0",
    "@cloudflare/vite-plugin": "1.15.3",
    "@cloudflare/workers-types": "4.20260317.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "16.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.48.0",
    "vite": "^6.4.1",
    "vite-plugin-qrcode": "^0.3.0",
    "vitest": "^3.2.4",
    "wrangler": "4.76.0",
    "zip-stream": "^7.0.5"
  }
}
